# Adres API (backend Spring Boot z katalogu `api/`).
# NEXT_PUBLIC_* trafia do przeglądarki — musi być adresem publicznym.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Opcjonalnie: adres używany przy renderowaniu po stronie serwera.
# Przydaje się, gdy API jest widoczne wewnętrznie pod inną nazwą
# (np. w dockerze: http://api:8080). Domyślnie używamy NEXT_PUBLIC_API_URL.
# API_URL=http://api:8080

# Adres publiczny witryny — buduje adresy kanoniczne, sitemapę, og:url
# i dane strukturalne. Musi być pełnym adresem z protokołem, bez ukośnika
# na końcu. Środowisko testowe MUSI mieć tu swój własny adres: wskazanie
# domeny produkcyjnej sprawiłoby, że Google zindeksuje testy jako produkcję.
NEXT_PUBLIC_SITE_URL=https://czulapodroz.pl
